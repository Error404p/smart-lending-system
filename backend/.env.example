# Server Port
PORT=5000

# MongoDB URI (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/smart-lending
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart-lending?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smart-lending

# JWT Secret Key for Token Signing
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Frontend URL for CORS (Optional: set to your Vercel URL in production)
CLIENT_URL=http://localhost:5173

